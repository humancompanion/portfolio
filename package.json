{
  "name": "portfolio",
  "version": "1.1.0",
  "description": "My portfolio",
  "engines": {
    "node": ">= 16"
  },
  "license": "OSL-3.0",
  "repository": "http://github.com/humancompanion/portfolio",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@guidepup/guidepup": "^0.28.1",
    "@guidepup/playwright": "^0.17.0",
    "@playwright/test": "^1.61.1",
    "axe-core": "^4.12.1",
    "express": "^4.22.2",
    "sass": "^1.102.0"
  },
  "scripts": {
    "build:css": "sass _scss/portfolio.scss:assets/css/portfolio.min.css _scss/portfolio-print.scss:assets/css/portfolio-print.min.css --load-path=_scss --style=compressed --no-source-map --quiet-deps",
    "watch:css": "sass --watch _scss/portfolio.scss:assets/css/portfolio.css _scss/portfolio-print.scss:assets/css/portfolio-print.css --load-path=_scss --style=expanded --source-map --quiet-deps",
    "build": "npm run build:css && JEKYLL_ENV=production bundle exec jekyll build",
    "serve": "JEKYLL_ENV=development bundle exec jekyll serve --livereload --incremental",
    "dev": "trap 'kill 0' EXIT; npm run watch:css & npm run serve & wait",
    "start": "npm run dev",
    "test": "bundle exec htmlproofer ./_site --disable-external",
    "test:a11y": "playwright test --project=axe",
    "test:sr": "playwright test --project=voiceover --project=nvda",
    "test:sr:voiceover": "playwright test --project=voiceover",
    "test:sr:nvda": "playwright test --project=nvda",
    "update": "bundle update"
  }
}
